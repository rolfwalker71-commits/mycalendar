{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./web/src/*"]
    },
    "baseUrl": "."
  },
  "include": ["web/src/**/*", "server/src/**/*"]
}
