# =============================================================================
# Umgebungsvariablen — Kopie als `.env` speichern und Werte anpassen.
# Sensible Daten gehören NUR in `.env` (liegt in .gitignore).
# =============================================================================

# Laufzeit: "development" lockert Cookie-Flags für lokales HTTP.
# Auf dem eigenen Server mit HTTPS auf "production" stellen.
NODE_ENV=development

# Host-Port der App (Browser: http://localhost:3366).
# Im Container lauscht die App fest auf 3366 (siehe Dockerfile / Compose).
APP_PORT=3366

# Geheimnis zum Signieren der JWT-Session-Cookies.
# In Produktion: lange, zufällige Zeichenkette (z. B. `openssl rand -base64 48`).
JWT_SECRET=bitte-durch-ein-langes-zufaelliges-geheimnis-ersetzen

# Gültigkeitsdauer des Login-Tokens (z. B. 7d, 24h, 12h).
JWT_EXPIRES_IN=7d

# Cookies nur über HTTPS senden. Lokal (HTTP) auf false lassen.
# Hinter einem Reverse-Proxy mit TLS auf true setzen.
COOKIE_SECURE=false

# AES-256-GCM-Schlüssel für Refresh-Tokens in der Datenbank.
# Falls leer, fällt die App auf JWT_SECRET zurück.
# Erzeugen: `openssl rand -base64 48`
APP_ENCRYPTION_KEY=bitte-durch-einen-langen-zufaelligen-schluessel-ersetzen

# Standard-Zeitzone (Anzeige). Google-Event-Zeitzonen bleiben erhalten.
TZ=Europe/Berlin

# Wochenbeginn: 1 = Montag (Standard), 0 = Sonntag.
WEEK_START=1

# Öffentliche Basis-URL (optional, für Google-Kalender-Webhooks später).
# Beispiel: https://kalender.example.com
PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# PostgreSQL — nur im internen Docker-Netz erreichbar (kein Port-Mapping).
# Der Hostname "db" ist der Service-Name aus docker-compose.yml.
# -----------------------------------------------------------------------------
POSTGRES_USER=kalenderuser
POSTGRES_PASSWORD=bitte-durch-ein-starkes-passwort-ersetzen
POSTGRES_DB=kalenderdb

# Verbindung aus dem App-Container. Host = Compose-Service "db".
# Sonderzeichen im Passwort müssen URL-kodiert werden.
DATABASE_URL=postgres://kalenderuser:bitte-durch-ein-starkes-passwort-ersetzen@db:5432/kalenderdb

# -----------------------------------------------------------------------------
# Google OAuth 2.0 (interner / Test-Consent, Testnutzer)
# Redirect-URIs in der Google-Cloud-Konsole:
#   http://localhost:3366/api/auth/google/callback
#   https://<produktion>/api/auth/google/callback
# APIs aktivieren: Google Calendar API und Gmail API.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=ihre-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=bitte-durch-das-google-client-secret-ersetzen
GOOGLE_REDIRECT_URI=http://localhost:3366/api/auth/google/callback

ALLOWED_GOOGLE_EMAILS=

# Optional: Ordner der Schichtklar-App, damit Schichtbilder im Kalender
# statt der Standard-Illustration erscheinen (lokal z. B. ../shiftplanner).
# SCHICHTKLAR_DIR=/home/rolf/DEV/shiftplanner

# -----------------------------------------------------------------------------
# Web Push (VAPID)
# Schlüssel werden beim ersten Start selbst erzeugt und in Postgres
# (Tabelle app_settings) gespeichert. Optional manuell setzen:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:du@example.com
# -----------------------------------------------------------------------------

# Gemini (optional). Die KI-Übersichten, die Gmail selbst speichert, gibt Google
# nicht über die Gmail-API heraus. Mit einem Schlüssel erzeugt die App eigene
# Zusammenfassungen für Mails und den Kalender-Tag.
# Schlüssel: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
